# ==============================================================================
# LEAD INTEL HUB - ENVIRONMENT VARIABLES
# ==============================================================================

# Google Maps Scraper Docker Engine
SCRAPER_BASE_URL=http://localhost:8080
SCRAPER_PORT=8080
SCRAPER_API_KEY=

# Supabase (PostgreSQL Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini AI (Exclusivo sob demanda para geração de Pitchs)
GEMINI_API_KEY=

# Optional: Google PageSpeed Insights API Key (para auditoria de performance sem limite)
PAGESPEED_API_KEY=
